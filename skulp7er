.btn-primary{color:#fff;border-color:var(--red);background:linear-gradient(135deg,rgba(255,46,56,.95),rgba(150,6,21,.86));box-shadow:0 0 28px rgba(255,46,56,.18)}
.btn-primary:hover{box-shadow:0 0 34px rgba(255,46,56,.35)}
.btn-ghost{border-color:rgba(84,239,255,.42);color:var(--cyan);background:rgba(84,239,255,.025)}
.hero-meta{display:flex;gap:26px;margin-top:44px;border-top:1px solid rgba(84,239,255,.13);padding-top:20px}.hero-meta div{display:flex;gap:8px;align-items:baseline}.hero-meta b{font-family:var(--font-display);color:var(--red);font-size:11px}.hero-meta span{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}

.hero-visual{position:relative}
.monitor-shell{position:relative;padding:15px;border:1px solid rgba(113,154,164,.4);background:linear-gradient(145deg,#111b20,#06090c 54%,#0a1115);clip-path:polygon(4% 0,96% 0,100% 4%,100% 96%,96% 100%,4% 100%,0 96%,0 4%);box-shadow:0 25px 70px rgba(0,0,0,.5),0 0 30px rgba(84,239,255,.07)}
.monitor-shell::before{content:"";position:absolute;inset:5px;border:1px solid rgba(255,46,56,.19);clip-path:inherit;pointer-events:none}
.monitor-topline,.monitor-bottom{display:flex;justify-content:space-between;gap:12px;padding:7px 10px;font-family:var(--font-display);font-size:9px;letter-spacing:.13em;color:#719198}.status{color:var(--red)}
.monitor-screen{position:relative;overflow:hidden;border:1px solid rgba(84,239,255,.24);background:#020304;aspect-ratio:1/1}
.monitor-screen img{width:100%;height:100%;object-fit:cover;filter:saturate(.9) contrast(1.06)}
.monitor-screen::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(84,239,255,.06),transparent 20%,transparent 82%,rgba(255,46,56,.05));mix-blend-mode:screen;pointer-events:none}
.screen-scan{position:absolute;inset:-30% 0 auto;height:26%;background:linear-gradient(transparent,rgba(84,239,255,.1),transparent);animation:scan 4.3s linear infinite;pointer-events:none}
@keyframes scan{to{transform:translateY(500%)}}
.hud{position:absolute;font-family:var(--font-display);font-size:8px;letter-spacing:.12em;color:var(--cyan);background:rgba(0,0,0,.6);border-left:2px solid var(--red);padding:5px 7px}.hud-a{left:4%;top:7%}.hud-b{right:3%;bottom:4%}
.reticle{position:absolute;right:13%;top:29%;width:54px;height:54px;border:1px solid rgba(255,46,56,.65);border-radius:50%;box-shadow:0 0 20px rgba(255,46,56,.22)}.reticle::before,.reticle::after{content:"";position:absolute;background:rgba(255,46,56,.7)}.reticle::before{width:74px;height:1px;left:-11px;top:26px}.reticle::after{height:74px;width:1px;top:-11px;left:26px}

.ticker{overflow:hidden;border-block:1px solid rgba(84,239,255,.12);background:#060a0d;box-shadow:inset 0 0 18px rgba(84,239,255,.02)}
.ticker-track{display:flex;width:max-content;gap:24px;align-items:center;padding:12px 0;font-family:var(--font-display);font-size:10px;letter-spacing:.18em;color:#80969a;animation:ticker 28s linear infinite}.ticker i{color:var(--red);font-style:normal}.ticker span{white-space:nowrap}
@keyframes ticker{to{transform:translateX(-50%)}}

.section{max-width:var(--max);margin:auto;padding:112px 24px}
.section-heading{display:grid;grid-template-columns:.46fr 1.1fr .8fr;column-gap:32px;align-items:end;margin-bottom:48px}.section-heading .eyebrow{margin:0 0 8px}.section-heading h2{font-size:clamp(35px,5vw,64px)}.section-heading p{margin:0;color:#84999f}
.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.service-card{position:relative;min-height:285px;padding:25px 22px;border:1px solid rgba(84,239,255,.14);background:linear-gradient(145deg,rgba(84,239,255,.025),rgba(255,255,255,.012));overflow:hidden;transition:.25s}.service-card::after{content:"";position:absolute;inset:auto -40% -60% 20%;height:180px;background:radial-gradient(circle,rgba(84,239,255,.08),transparent 65%);transition:.3s}.service-card:hover{transform:translateY(-5px);border-color:rgba(84,239,255,.4);box-shadow:0 18px 44px rgba(0,0,0,.24)}.service-code{font-family:var(--font-display);font-size:10px;color:var(--red);letter-spacing:.18em}.service-card h3{font-family:var(--font-display);font-size:19px;text-transform:uppercase;margin:48px 0 12px}.service-card p{font-size:16px;color:#89a0a5;margin-bottom:24px}.tags{display:flex;gap:6px;flex-wrap:wrap}.tags span{font-size:10px;text-transform:uppercase;letter-spacing:.12em;border:1px solid rgba(119,147,154,.2);padding:5px 7px;color:#81969a}

.process-section{padding-top:70px}.process-line{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid rgba(84,239,255,.2)}.process-step{position:relative;padding:30px 18px 0;border-right:1px solid rgba(84,239,255,.12);min-height:180px}.process-step:first-child{border-left:1px solid rgba(84,239,255,.12)}.process-step::before{content:"";position:absolute;top:-4px;left:16px;width:7px;height:7px;background:var(--red);box-shadow:0 0 10px var(--red)}.process-step span{font-family:var(--font-display);font-size:10px;color:var(--cyan)}.process-step h3{font-family:var(--font-display);letter-spacing:.08em;margin:12px 0 9px}.process-step p{font-size:15px;color:#81979d;margin:0}

.project-grid{display:grid;grid-template-columns:1.35fr .85fr;grid-template-rows:repeat(2,340px);gap:12px}.project-card{position:relative;margin:0;overflow:hidden;border:1px solid rgba(84,239,255,.15);background:#090d10}.project-wide{grid-row:span 2}.project-card img{width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,.7,.2,1),filter .4s}.project-card::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 45%,rgba(0,0,0,.88));pointer-events:none}.project-card:hover img{transform:scale(1.035);filter:saturate(1.15)}.project-card figcaption{position:absolute;z-index:2;left:22px;right:22px;bottom:20px;display:grid;grid-template-columns:auto 1fr;align-items:end;column-gap:12px}.project-card figcaption span{font-family:var(--font-display);font-size:9px;color:var(--red);letter-spacing:.15em;grid-column:1/-1}.project-card figcaption b{font-family:var(--font-display);font-size:22px;letter-spacing:.05em}.project-card figcaption small{text-align:right;color:#8ba0a5;text-transform:uppercase;letter-spacing:.1em;font-size:10px}

.about-section{padding-top:70px}.about-panel{display:grid;grid-template-columns:1fr .9fr;gap:12px}.about-copy,.terminal{border:1px solid rgba(84,239,255,.14);background:rgba(8,14,18,.62);padding:38px}.about-copy h2{font-size:clamp(38px,5vw,66px);margin-bottom:25px}.about-copy p{color:#91a5a9;max-width:650px}.about-copy strong{color:#fff}.terminal{padding:0;align-self:stretch}.terminal-bar{height:42px;display:flex;align-items:center;gap:7px;padding:0 14px;border-bottom:1px solid rgba(84,239,255,.12);font-family:var(--font-display);font-size:9px;color:#67858c}.terminal-bar span{width:8px;height:8px;border-radius:50%;background:#38464a}.terminal-bar span:first-child{background:var(--red)}.terminal-bar b{margin-left:8px;font-weight:500}.terminal pre{margin:0;padding:34px;white-space:pre-wrap;color:#78eaff;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:13px;line-height:1.9}.blink{animation:blink 1s steps(1) infinite}@keyframes blink{50%{opacity:0}}

.contact-section{padding-top:60px}.contact-panel{display:grid;grid-template-columns:.95fr 1.05fr;gap:56px;padding:50px;border:1px solid rgba(255,46,56,.22);background:linear-gradient(135deg,rgba(255,46,56,.035),rgba(84,239,255,.018));position:relative}.contact-panel::before{content:"07";position:absolute;right:20px;top:-30px;font-family:var(--font-display);font-size:118px;font-weight:900;color:rgba(255,255,255,.018);pointer-events:none}.contact-panel h2{font-size:clamp(40px,5vw,68px);margin:0 0 22px}.contact-panel p{color:#8fa2a6}.contact-links{display:flex;gap:8px;flex-wrap:wrap;margin-top:28px}.contact-links a{font-family:var(--font-display);font-size:9px;letter-spacing:.12em;padding:9px 11px;border:1px solid rgba(84,239,255,.16);color:#8ea4a9}.contact-links a:hover{color:var(--cyan);border-color:var(--cyan)}
.contact-form{display:grid;grid-template-columns:1fr 1fr;gap:14px}.contact-form label{font-family:var(--font-display);font-size:9px;letter-spacing:.12em;color:#779096}.contact-form label:nth-child(4){grid-column:1/-1}.contact-form input,.contact-form select,.contact-form textarea{display:block;width:100%;margin-top:7px;border:1px solid rgba(84,239,255,.14);background:#05090c;color:#dce6e8;padding:12px 13px;outline:0;border-radius:0}.contact-form input:focus,.contact-form select:focus,.contact-form textarea:focus{border-color:var(--cyan);box-shadow:0 0 0 2px rgba(84,239,255,.04)}.contact-form textarea{resize:vertical}.contact-form .btn{width:max-content}.form-note{align-self:center;color:#60777d;font-size:12px}

.site-footer{max-width:var(--max);margin:0 auto;padding:30px 24px 44px;border-top:1px solid rgba(84,239,255,.11);display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center;gap:18px;color:#647b81;font-family:var(--font-display);font-size:9px;letter-spacing:.1em}.site-footer>div:first-child{display:flex;flex-direction:column;gap:5px}.site-footer .brand-name{color:#dfe7e8}.footer-code{text-align:center}.site-footer>div:last-child{text-align:right}

.reveal{opacity:0;transform:translateY(22px);transition:opacity .72s ease,transform .72s ease}.reveal.visible{opacity:1;transform:none}

@media (max-width:1050px){
  .hero{grid-template-columns:1fr;min-height:auto;padding-top:84px}.hero-copy{max-width:800px}.hero-visual{max-width:760px;width:100%;margin:auto}
  .section-heading{grid-template-columns:1fr}.section-heading h2{max-width:850px;margin-top:10px}.section-heading p{max-width:600px;margin-top:20px}
  .service-grid{grid-template-columns:repeat(2,1fr)}.process-line{grid-template-columns:repeat(3,1fr);row-gap:24px}.about-panel,.contact-panel{grid-template-columns:1fr}
}
@media (max-width:760px){
  body{font-size:16px}.site-header{height:68px;padding:0 18px}.brand-name{font-size:13px}.nav-toggle{display:block;position:relative;z-index:3}.nav{position:absolute;left:0;right:0;top:68px;display:none;flex-direction:column;align-items:stretch;gap:0;background:#05090c;border-bottom:1px solid rgba(84,239,255,.2);padding:10px 18px 18px}.nav.open{display:flex}.nav a{padding:13px 8px;border-bottom:1px solid rgba(255,255,255,.04)}
  .hero{padding:54px 18px 48px;gap:38px}.hero h1{font-size:clamp(42px,14vw,70px)}.hero-lead{font-size:18px}.hero-meta{display:grid;grid-template-columns:1fr 1fr;gap:13px}.monitor-topline,.monitor-bottom{font-size:7px}.reticle{display:none}
  .section{padding:80px 18px}.service-grid{grid-template-columns:1fr}.service-card{min-height:230px}.service-card h3{margin-top:35px}.process-line{grid-template-columns:1fr}.process-step{border-left:1px solid rgba(84,239,255,.12);min-height:130px}.project-grid{grid-template-columns:1fr;grid-template-rows:none}.project-card,.project-wide{height:390px;grid-row:auto}.about-copy,.terminal{padding:26px}.terminal pre{padding:25px;font-size:11px}.contact-panel{padding:28px 22px;gap:34px}.contact-form{grid-template-columns:1fr}.contact-form label:nth-child(4){grid-column:auto}.site-footer{grid-template-columns:1fr;text-align:left}.footer-code,.site-footer>div:last-child{text-align:left}.cursor-glow{display:none}
}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
